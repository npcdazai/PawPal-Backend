# Copy to .env (git-ignored) and fill in. With nothing set, the server runs locally with its
# data in .data/dev-store.json (kept across restarts), logged push and dev logins only.

PORT=4000
# NODE_ENV=production

# Signs the API's session tokens. At least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset in development: a key saved in .data/dev-session-secret, so apps stay signed in across restarts.
SESSION_SECRET=
# How long an app stays signed in without signing in again.
SESSION_DAYS=30

# ─── Logging ─────────────────────────────────────────────────────────────────
# Defaults: development = pretty · debug · changes; production = json · info · off.
# LOG_LEVEL   debug (every request, polls included) | info (changes and events) | warn | error | silent
# LOG_FORMAT  pretty (coloured lines for people) | json (one object per line for log collectors)
# LOG_BODIES  off | changes (request bodies and replies of everything but successful reads) | all
# Secrets (tokens, OTPs, signatures, keys) are always hidden; phone numbers, emails and UPI IDs masked.
# LOG_LEVEL=debug
# LOG_FORMAT=pretty
# LOG_BODIES=changes

# ─── Firebase (Firestore, FCM push, Phone Number Verification) ───────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Save the JSON outside git (e.g. secrets/firebase-admin.json) and point here:
FIREBASE_SERVICE_ACCOUNT=
# Usually read from the key file; set it if you use GOOGLE_APPLICATION_CREDENTIALS instead.
FIREBASE_PROJECT_ID=
# Override the defaults (firestore + fcm when Firebase is configured, file + log otherwise).
# STORE: firestore | file (development: memory saved to STORE_FILE, kept across restarts) | memory (lost on restart)
# STORE=firestore
# STORE_FILE=.data/dev-store.json
# PUSH=fcm

# Accept "dev:+919876543210" as a phone token (web builds / emulators). Ignored in production.
# Sign-in codes requested with method "dev" are printed in this console instead of being texted.
AUTH_DEV_LOGIN=true
# Development: keep `adb reverse tcp:$PORT tcp:$PORT` on USB phones and emulators (checked every 10 s),
# so dev builds reach this API at localhost after a replug or an adb restart. Never runs in production.
# adb is found via ADB_PATH, then ANDROID_HOME / ANDROID_SDK_ROOT, then the default SDK folder, then PATH.
ADB_REVERSE=true
# ADB_PATH=C:\Users\you\AppData\Local\Android\Sdk\platform-tools\adb.exe
# Approve partner applications immediately (no manual vetting yet). Defaults to off in production.
AUTO_APPROVE_PARTNERS=true

# ─── Payments (YouPI PG) ─────────────────────────────────────────────────────
# Set all three to make bookings payment-first; required in production. Without them (development)
# bookings skip payment. The merchant key is YouPI's webhook secret: keep it on this server only.
# YOUPI_URL=https://pay.example.com
# YOUPI_MERCHANT_ID=
# YOUPI_MERCHANT_KEY=
# Point YouPI's webhook for this merchant at  https://<this API>/webhooks/youpi
# A SUCCESS counts as paid at this verification level (0 none, 1 one bank-alert source, 2 two).
PAYMENT_MIN_VERIFICATION_LEVEL=1
PAYMENT_RETURN_URL=pawpal://payment-return
PAYMENT_HOLD_MINUTES=30

# ─── Maps (free OpenStreetMap services) ──────────────────────────────────────
# The public servers require the app to identify itself: name + a contact.
MAPS_USER_AGENT=PawPal-API/0.1 (contact: you@example.com)
# Limit search results to one country ("any" for none).
MAPS_COUNTRY=in
# Defaults are the public servers; point these at self-hosted copies for real traffic.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PHOTON_URL=https://photon.komoot.io
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
# MAPS_ENABLED=false

# ─── Weather (home screen) ───────────────────────────────────────────────────
# Open-Meteo's forecast API, no key. Its free API is for NON-COMMERCIAL use only: before launch use its
# paid plan (customer URL with your key, e.g. https://customer-api.open-meteo.com/v1/forecast?apikey=…)
# or another provider behind the same response. Readings are cached 15 minutes per ~1 km cell.
# WEATHER_URL=https://api.open-meteo.com/v1/forecast
# Off: GET /weather answers 503 weather_unavailable and the app hides the weather.
# WEATHER_ENABLED=false

# ─── Walker dispatch ─────────────────────────────────────────────────────────
DISPATCH_OFFER_SECONDS=25
DISPATCH_MAX_OFFERS=5
DISPATCH_LOCATION_MAX_AGE_MINUTES=15

# ─── Partner verification (4 gates) ──────────────────────────────────────────
# Setting DATABASE_URL turns it on (Postgres 16 + pgvector; `docker compose up -d`).
# DATABASE_URL=postgres://pawpal:pawpal-dev-only@localhost:5432/pawpal
# …or, without Docker, an in-process Postgres saved in a folder (development only):
# DATABASE_URL=pglite://.data/pglite
# Keys the ID-number hash. 32+ random characters; never change it once IDs are stored.
ID_HASH_PEPPER=
# Signs background-check results posted to /api/v1/partner-verification/webhooks/background-check.
BGV_WEBHOOK_SECRET=

# Open-weight vision model behind any OpenAI-compatible API (Ollama, vLLM, Together, OpenRouter).
VLM_BASE_URL=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen2.5vl:7b
VLM_TIMEOUT_MS=180000
# Also run the VLM on the doorstep selfie (adds its latency at the door).
VLM_SHIFT_CHECK=true

# Face engine: auto = native TensorFlow if it loads (Linux, Node 20/22), else WASM.
FACE_BACKEND=auto
# Cosine-similarity thresholds. Calibrate on real ID/selfie pairs before launch.
FACE_MATCH_ENROLL=0.82
FACE_MATCH_SHIFT=0.85
FACE_DUPLICATE_THRESHOLD=0.88
FACE_ANTISPOOF_MIN=0.5
FACE_LIVENESS_MIN=0.5
FACE_MAX_POSE_DEGREES=25
KYC_MAX_ID_ATTEMPTS=5
SHIFT_GEOFENCE_METERS=100
# Background-check vendor per market. Only "manual" (ops posts results to the webhook) exists so far.
BGV_PROVIDER_IN=manual
BGV_PROVIDER_GLOBAL=manual

# Browser origins allowed to call the API (Expo web dev servers).
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:8083
